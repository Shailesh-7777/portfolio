<svg width="400" height="400" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <radialGradient id="avatarGlow" cx="50%" cy="40%" r="55%">
      <stop offset="0%" stop-color="#1E1B4B" stop-opacity="0.9"/>
      <stop offset="60%" stop-color="#0F172A" stop-opacity="0.95"/>
      <stop offset="100%" stop-color="#08090D"/>
    </radialGradient>
    <linearGradient id="neonRing" x1="0" y1="0" x2="400" y2="400" gradientUnits="userSpaceOnUse">
      <stop stop-color="#06B6D4"/>
      <stop offset="0.5" stop-color="#A855F7"/>
      <stop offset="1" stop-color="#3B82F6"/>
    </linearGradient>
    <linearGradient id="bodyGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#334155"/>
      <stop offset="100%" stop-color="#1E293B"/>
    </linearGradient>
    <linearGradient id="faceGrad" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#D4A373"/>
      <stop offset="100%" stop-color="#BC6C25"/>
    </linearGradient>
  </defs>

  <!-- Background Circle -->
  <circle cx="200" cy="200" r="190" fill="url(#avatarGlow)" stroke="url(#neonRing)" stroke-width="3"/>
  <circle cx="200" cy="200" r="175" stroke="#06B6D4" stroke-opacity="0.15" stroke-dasharray="6 6"/>

  <!-- Developer Silhouette Representation -->
  <g transform="translate(0, 10)">
    <!-- Shoulders & Torso with Hoodie/Blazer -->
    <path d="M 100 350 C 100 270, 140 240, 200 240 C 260 240, 300 270, 300 350 Z" fill="url(#bodyGrad)"/>
    <path d="M 160 245 L 200 290 L 240 245" stroke="#06B6D4" stroke-width="2" fill="none" opacity="0.6"/>

    <!-- Neck -->
    <rect x="182" y="195" width="36" height="50" rx="6" fill="#BC6C25"/>

    <!-- Head / Face -->
    <ellipse cx="200" cy="160" rx="55" ry="65" fill="#D4A373"/>

    <!-- Hair -->
    <path d="M 142 150 C 140 100, 170 85, 200 85 C 235 85, 260 100, 258 150 C 250 120, 230 105, 200 108 C 170 110, 150 125, 142 150 Z" fill="#18181B"/>

    <!-- Modern Glasses -->
    <rect x="155" y="145" width="36" height="24" rx="6" fill="rgba(6,182,212,0.15)" stroke="#06B6D4" stroke-width="2"/>
    <rect x="209" y="145" width="36" height="24" rx="6" fill="rgba(6,182,212,0.15)" stroke="#06B6D4" stroke-width="2"/>
    <line x1="191" y1="157" x2="209" y2="157" stroke="#06B6D4" stroke-width="2"/>
    <line x1="145" y1="157" x2="155" y2="157" stroke="#06B6D4" stroke-width="2"/>
    <line x1="245" y1="157" x2="255" y2="157" stroke="#06B6D4" stroke-width="2"/>

    <!-- Gentle Smile -->
    <path d="M 185 195 Q 200 205 215 195" stroke="#78350F" stroke-width="2.5" stroke-linecap="round" fill="none"/>
  </g>

  <!-- Tech Accent Overlays -->
  <g transform="translate(45, 45)">
    <circle cx="15" cy="15" r="14" fill="#0E121E" stroke="#06B6D4" stroke-width="1.5"/>
    <text x="15" y="19" text-anchor="middle" fill="#06B6D4" font-family="monospace" font-size="10" font-weight="700">&lt;/&gt;</text>
  </g>

  <g transform="translate(310, 45)">
    <circle cx="15" cy="15" r="14" fill="#0E121E" stroke="#A855F7" stroke-width="1.5"/>
    <text x="15" y="20" text-anchor="middle" fill="#A855F7" font-family="monospace" font-size="11" font-weight="700">JS</text>
  </g>

  <!-- Bottom Monogram Pill -->
  <g transform="translate(150, 335)">
    <rect x="0" y="0" width="100" height="26" rx="13" fill="#0B0E17" stroke="#06B6D4" stroke-width="1.5"/>
    <text x="50" y="17" text-anchor="middle" fill="#FFFFFF" font-family="sans-serif" font-size="11" font-weight="700" letter-spacing="1">SHAILESH</text>
  </g>
</svg>
